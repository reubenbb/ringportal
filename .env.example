# Copy to .env.local for local development. Never commit real values.

# Least-privilege application login role (member of ringportal_app; NOT the owner role).
DATABASE_URL=postgres://ringportal_app_login:CHANGE_ME@127.0.0.1:5432/ringportal_dev
# Owner role, used only by `npm run db:migrate`. Not needed by the running app.
DATABASE_MIGRATION_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/ringportal_dev

APP_ORIGIN=http://localhost:3000

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
LOG_HASH_KEY=

# console (development only) | disabled. No production email provider is configured yet.
MAIL_TRANSPORT=console
